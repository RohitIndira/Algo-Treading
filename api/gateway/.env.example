# API Gateway Configuration

# Server Configuration
HTTP_PORT=8080
GRPC_TIMEOUT=30s

# Service Endpoints
USER_CONFIG_GRPC_ADDR=localhost:50051
USER_LOGIN_SERVICE_URL=http://localhost:8002
TRADE_EXECUTION_GRPC_ADDR=localhost:9004

# Internal API key shared only between API gateway and user-login-service.
# This must match INTERNAL_API_KEY in services/user-login-service/.env so
# that the gateway can call protected credentials/admin endpoints on
# behalf of the frontend without exposing the secret to clients.
INTERNAL_API_KEY=Zt3f8q9YpL1sB7uC2rV6wX0mN4kR8dJ

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

