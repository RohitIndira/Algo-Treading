# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=trading_system
MONGO_MARKET_DATA_COLLECTION=market_data
MONGO_USER_CONFIG_COLLECTION=user_configs

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10


# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MARKET_DATA=market.data.news
KAFKA_CONSUMER_GROUP=rules-engine-group
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=3

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=orders
RABBITMQ_QUEUE=order.execution.queue
RABBITMQ_DLX=order.execution.dlx
RABBITMQ_DLQ=order.execution.dlq

# Odin API Configuration
ODIN_API_URL=https://api.odin.example.com
ODIN_API_KEY=your_api_key_here
ODIN_SECRET_KEY=your_secret_key_here
ODIN_TIMEOUT=30s

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Service Ports
API_GATEWAY_PORT=8080
USER_CONFIG_GRPC_PORT=9001
DATA_INGESTION_GRPC_PORT=9002
RULES_ENGINE_GRPC_PORT=9003
TRADE_EXECUTION_GRPC_PORT=9004
RISK_MANAGEMENT_GRPC_PORT=9005

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9100
PROMETHEUS_PUSHGATEWAY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Environment
ENVIRONMENT=development
DEBUG=false
