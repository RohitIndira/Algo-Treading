            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/{{user_id}}/credential/expire",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users",
                "{{user_id}}",
                "credential",
                "expire"
              ]
            },
            "description": "⚠ LIVE-FIRE (CONFIRM tier): blanks the stored broker token so every automated action for this user halts until their next platform login. Body {} first to see the 412 gate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
