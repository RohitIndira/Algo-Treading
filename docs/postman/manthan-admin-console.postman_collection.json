    {
      "name": "M6 · Signal Pipeline Explorer",
      "item": [
        {
          "name": "End-to-end trace",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/trace/SHREEPUSHK?days=10&user_id=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "trace",
                "SHREEPUSHK"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "10",
                  "description": "lookback window (default 60, max 365)"
                },
                {
                  "key": "user_id",
                  "value": "",
                  "description": "optional user filter"
                }
              ]
            },
            "description": "One symbol as a chronological timeline: sheet run + verdict → signal published → per-user allocator decision → inbox (class/attempts/error) → every order attempt (broker id, error, SL lineage) → fills → position open/exit + P&L → trail state → cooldown. Optional user_id filter."
          }
        },
        {
          "name": "Candidate universe (why not signaled?)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/signals/candidates?date=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "signals",
                "candidates"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "",
                  "description": "YYYY-MM-DD (optional; empty = latest run)"
                }
