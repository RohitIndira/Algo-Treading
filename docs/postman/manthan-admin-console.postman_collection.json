{
  "info": {
    "name": "Manthan Admin Console (M1–M6)",
    "description": "Complete admin API surface as of 2026-08-31 (commit 48c6888).\n\nSETUP\n1. Set collection variable `user_session_jwt` to the platform SSO cookie `user_session` (HS512 — starts eyJhbGciOiJIUzUxMiJ9). NOT the `user_token` cookie.\n2. Run '1. Elevate' — its test script auto-saves `admin_token` for every other request.\n3. Token expires after 30 min — just re-run Elevate.\n\nTIERS\nREAD: plain request. CONFIRM: body must carry \"confirmed\": true (else 412). TYPED (delete strategy): call with {\"preview\":true} to receive the exact blast-radius text, then resend it verbatim as \"confirmation_text\".\n\nEvery mutating call — including denials — lands in the append-only audit trail.\n\n⚠ LIVE-FIRE requests are marked in their descriptions. Everything else is read-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://manthan.stockk.trade"
    },
    {
      "key": "user_session_jwt",
      "value": "PASTE-user_session-COOKIE-JWT-HERE"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "strategy_id",
      "value": "a6cb5b08-dddd-4e54-ad2d-d5ae55edb3c9",
      "description": "S4450's Manthan strategy (get others from Fleet)"
    },
    {
      "key": "user_id",
      "value": "S4450"
    }
  ],
  "item": [
    {
      "name": "M1 · Session & Audit",
      "item": [
        {
          "name": "1. Elevate (get admin token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_session_jwt}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/elevate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "elevate"
              ]
            },
            "description": "Exchange your platform SSO JWT for a 30-min admin session token. Rate-limited 3/15min. The test script auto-saves admin_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-save the admin token for every other request in this collection.",
                  "const js = pm.response.json();",
                  "if (js && js.data && js.data.admin_token) {",
                  "    pm.collectionVariables.set('admin_token', js.data.admin_token);",
                  "    console.log('admin_token saved, expires', js.data.expires_at);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Whoami",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/whoami",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "whoami"
              ]
            },
            "description": "Verify the current admin session: admin id + expiry."
          }
        },
        {
          "name": "3. Audit trail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/audit?limit=50&since=&admin_id=&target_user=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "audit"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "max rows"
                },
                {
                  "key": "since",
                  "value": "",
                  "description": "RFC3339 lower bound (optional)"
                },
                {
                  "key": "admin_id",
                  "value": "",
                  "description": "filter by admin (optional)"
                },
                {
                  "key": "target_user",
                  "value": "",
                  "description": "filter by target (optional)"
                }
              ]
            },
            "description": "Append-only audit log, newest first. Filters: limit, since (RFC3339), admin_id, target_user. Immutable even to superuser (trigger-enforced)."
          }
        },
        {
          "name": "4. Audit CSV export",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/audit?format=csv&limit=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "audit"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "csv",
                  "description": "CSV export"
                },
                {
                  "key": "limit",
                  "value": "500",
                  "description": ""
                }
              ]
            },
            "description": "Same rows as the audit trail, as RFC-4180 CSV with UTC ISO timestamps — the compliance export."
          }
        },
        {
          "name": "5. Logout (revoke token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "logout"
              ]
            },
            "description": "Revoke the current admin session immediately."
          }
        }
      ]
    },
