            "description": "Probe every user holding an active strategy (also runs automatically 08:30 IST daily). Failures feed the attention queue."
          }
        },
        {
          "name": "Force-expire a credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "description": "From Elevate (30-min expiry)"
