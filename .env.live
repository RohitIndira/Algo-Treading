# LIVE ENVIRONMENT CONFIGURATION
# This file is used for the production docker-compose setup
# All services reference these values

# MongoDB Configuration
MONGO_URI=mongodb://admin:admin@mongodb:27017
MONGO_DATABASE=trading_system
MONGO_MARKET_DATA_COLLECTION=market_data
MONGO_USER_CONFIG_COLLECTION=user_configs

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=trading_

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_MARKET_DATA=market.data.news
KAFKA_CONSUMER_GROUP=rules-engine-group
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=1

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=orders
RABBITMQ_QUEUE=order.execution.queue
RABBITMQ_DLX=order.execution.dlx
RABBITMQ_DLQ=order.execution.dlq

# Odin API Configuration
ODIN_API_URL=https://api.odin.example.com
ODIN_API_KEY=your_api_key_here
ODIN_SECRET_KEY=your_secret_key_here
ODIN_TIMEOUT=30s

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Service Ports (Internal - used by services within Docker)
API_GATEWAY_PORT=8081
USER_CONFIG_GRPC_PORT=50051
DATA_INGESTION_GRPC_PORT=50052
RULES_ENGINE_GRPC_PORT=50053
TRADE_EXECUTION_GRPC_PORT=50054
RISK_MANAGEMENT_GRPC_PORT=50055

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9100
PROMETHEUS_PUSHGATEWAY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Environment
ENVIRONMENT=production
DEBUG=false

# External Service Endpoints (for live)
USER_LOGIN_SERVICE_URL=http://localhost:8002
INDIRA_BASE_URL=https://livemiddleware.indiratrade.com
ODIN_BASE_URL=http://localhost:8001
PAPER_MARKET_WS_URL=wss://stockkaskwebsocket.indiratrade.com/enhanced-stream
