# Database Configuration (PostgreSQL - for fetching user credentials)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_system
DB_USER=trading_user
DB_PASSWORD=your_db_password

# RabbitMQ Configuration (for consuming trade execution orders)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=trade.execution
RABBITMQ_QUEUE=trade.executions
RABBITMQ_ROUTING_KEY=order.new

# Encryption Key (for decrypting stored passwords - optional, leave empty for plain text)
ENCRYPTION_KEY=

# Service Configuration
SERVICE_PORT=8001
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
