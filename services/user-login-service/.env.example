# User Login Service Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=trading_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Kafka Configuration (Optional)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SESSION_CREATED=user.session.created
KAFKA_TOPIC_SESSION_EXPIRED=user.session.expired
KAFKA_TOPIC_LOGIN_ATTEMPT=user.login.attempt

# Service Configuration
SERVICE_PORT=50053
SERVICE_HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=user-login-service

# Security Configuration
# IMPORTANT: Generate a secure 32-byte encryption key for production
# Example: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!
SESSION_EXPIRY_HOURS=24
MAX_ACTIVE_SESSIONS_PER_USER=5

# ODIN API Default Configuration (Optional - can be stored per user)
DEFAULT_ODIN_API_URL=https://jri4df7kaa.execute-api.ap-south-1.amazonaws.com/prod/interactive
DEFAULT_ODIN_SOURCE=MOBILEAPI

# Rate Limiting (Future enhancement)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
