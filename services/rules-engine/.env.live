# Rules Engine Service Configuration (LIVE)

# Service Configuration
SERVICE_NAME=rules-engine-service
SERVICE_PORT=50053
ENVIRONMENT=production

# Kafka (LIVE)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_INPUT=market.data.news
KAFKA_TOPIC_OUTPUT=order.execution.queue
KAFKA_CONSUMER_GROUP=rules-engine-group
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=1

# Redis (LIVE)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=false
