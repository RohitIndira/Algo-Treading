# Rules Engine Service Configuration (STAGING)

# Service Configuration
SERVICE_NAME=rules-engine-service-staging
SERVICE_PORT=50053
ENVIRONMENT=staging

# Kafka (STAGING)
KAFKA_BROKERS=kafka-staging:9092
KAFKA_TOPIC_INPUT=market.data.news
KAFKA_TOPIC_OUTPUT=order.execution.queue
KAFKA_CONSUMER_GROUP=rules-engine-group-staging
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=1

# Redis (STAGING)
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=true
