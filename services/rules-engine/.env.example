# Service Configuration
SERVICE_NAME=rules-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
GRPC_PORT=9003
METRICS_PORT=9103

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=news-events

# News consumer group
NEWS_CONSUMER_GROUP_ID=rule-engine-news-processor

# News offset reset: earliest/latest
KAFKA_START_OFFSET=latest

# Config sync (user config deltas)
CONFIG_KAFKA_TOPIC=user-config-events
CONFIG_CONSUMER_GROUP_ID=rule-engine-config-sync

# Config offset reset: earliest/latest
CONFIG_KAFKA_OFFSET_RESET=earliest

KAFKA_COMMIT_INTERVAL=1s
KAFKA_MAX_BYTES=10485760

# Redis Configuration (LTP lookup)
# Either set REDIS_URI or REDIS_ADDRS
REDIS_URI=localhost:6379
# REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_CACHE_TTL=5m
REDIS_CLUSTER_MODE=false

# RabbitMQ removed (Kafka-only publishing)

# gRPC Client Configuration
USER_CONFIG_GRPC_ADDR=localhost:50051
RISK_MANAGEMENT_SERVICE_ADDR=localhost:9005

# Performance Configuration
WORKER_COUNT=10
MAX_BATCH_SIZE=100
MAX_CONCURRENT_MATCHES=50
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30s

# Set false for testing after market hours
MARKET_ENFORCE_HOURS=false

# MongoDB Configuration (trading holidays from OdinMasterData)
MONGODB_URI=mongodb://localhost:27017

# ─── Manthan CQRS — manual interference detection ────────────────────────────
# Gate the new write path. When true, entry decisions go to
# manthan_signal_decisions (intent log) and the PositionProjector becomes the
# sole atomic writer to manthan_positions / manthan_position_events. When
# false, falls back to legacy optimistic write (pre-CQRS behaviour).
MANTHAN_DECISION_LOG_ENABLED=false

# Publishes user-facing notifications to the manthan.notifications Kafka topic
# on MANUAL_EXIT_DETECTED / MANUAL_PARTIAL_EXIT_DETECTED /
# MANUAL_SL_CANCELLED_DETECTED. Best-effort — never rolls back a DB projection.
MANTHAN_NOTIFICATIONS_ENABLED=false
