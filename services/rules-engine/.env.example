# Service Configuration
SERVICE_NAME=rules-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
GRPC_PORT=9003
METRICS_PORT=9103

# Kafka — only the live fields after 2026-06-25 Cat B trim
KAFKA_BROKERS=localhost:9092

# Config sync (user-config-events deltas)
CONFIG_KAFKA_TOPIC=user-config-events
CONFIG_CONSUMER_GROUP_ID=rule-engine-config-sync
CONFIG_KAFKA_OFFSET_RESET=earliest

# User Config gRPC (bootstrap source-of-truth)
USER_CONFIG_GRPC_ADDR=localhost:50051

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_db
POSTGRES_SSLMODE=disable

# Manthan signals source DB (Phase 3 will flip to stockk_market)
MANTHAN_SIGNALS_DB=market_data

# Redis (LTP lookup + EMA target cache + Manthan signal cache)
# Either set REDIS_URI or REDIS_ADDRS
REDIS_URI=localhost:6379
# REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_CACHE_TTL=5m
REDIS_CLUSTER_MODE=false

# External Redis — Indira live LTP feed (production data)
EXT_REDIS_ADDR=
EXT_REDIS_PASSWORD=

# ─── Manthan CQRS ────────────────────────────────────────────────────────────
# Gate the write path. When true, entry decisions go to
# manthan_signal_decisions (intent log) and the PositionProjector becomes the
# sole atomic writer to manthan_positions / manthan_position_events. When
# false, falls back to legacy optimistic write (pre-CQRS behaviour).
MANTHAN_DECISION_LOG_ENABLED=false

# Publishes user-facing notifications to the manthan.notifications Kafka topic
# on MANUAL_EXIT_DETECTED / MANUAL_PARTIAL_EXIT_DETECTED /
# MANUAL_SL_CANCELLED_DETECTED. Best-effort — never rolls back a DB projection.
MANTHAN_NOTIFICATIONS_ENABLED=false
