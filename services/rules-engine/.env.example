# Service Configuration
SERVICE_NAME=rules-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
GRPC_PORT=9003
METRICS_PORT=9103

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=market.data.news
KAFKA_CONSUMER_GROUP=rules-engine-group
#KAFKA_START_OFFSET=latest
KAFKA_START_OFFSET=earliest
KAFKA_COMMIT_INTERVAL=1s
KAFKA_MAX_BYTES=10485760

# Elasticsearch Configuration
ELASTICSEARCH_URLS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=user_strategies
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_TIMEOUT=5s

# Redis Configuration
REDIS_ADDRS=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_CACHE_TTL=5m
REDIS_CLUSTER_MODE=false

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=trade.execution
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=trade.executions
RABBITMQ_ROUTING_KEY=order.new
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=1s

# gRPC Client Configuration
USER_CONFIG_SERVICE_ADDR=localhost:50051
RISK_MANAGEMENT_SERVICE_ADDR=localhost:9005

# Performance Configuration
WORKER_COUNT=10
MAX_BATCH_SIZE=100
MAX_CONCURRENT_MATCHES=50
MIN_MATCH_SCORE=0.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30s
