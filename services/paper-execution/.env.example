# Paper Execution Service (CASH_52W_HIGH)
SERVICE_NAME=paper-execution
SERVICE_PORT=9010

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=paper-execution-service
KAFKA_TOPIC_TRADE_SIGNALS=trade-signals
KAFKA_TOPIC_PAPER_EXECUTIONS=paper-executions.52w
KAFKA_TOPIC_PAPER_PNL=paper-pnl.52w

# Redis market data (same keys used by rules-engine realtime join)
MARKET_REDIS_ADDR=65.20.83.31:6379
MARKET_REDIS_PASSWORD=
MARKET_REDIS_DB=0

# Strategy filter
STRATEGY_ID=CASH_52W_HIGH
TRADING_MODE=PAPER

# Exit rules
SL_PCT=10
TSL_PCT=20
POLL_INTERVAL=5s

# Optional: emit aggregated PnL snapshots
EMIT_PNL_SNAPSHOTS=false
PNL_SNAPSHOT_INTERVAL=30s
