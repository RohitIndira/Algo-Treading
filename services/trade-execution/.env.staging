# Trade Execution Service Configuration (STAGING)

# Service Configuration
SERVICE_NAME=trade-execution-service-staging
SERVICE_PORT=50054
ENVIRONMENT=staging

# PostgreSQL (STAGING)
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_db_staging
POSTGRES_SSL_MODE=disable
MAX_OPEN_CONNS=25
MAX_IDLE_CONNS=5

# RabbitMQ (STAGING)
RABBITMQ_URL=amqp://guest:guest@rabbitmq-staging:5672/
RABBITMQ_QUEUE=order.execution.queue
RABBITMQ_EXCHANGE=order.execution.exchange
RABBITMQ_PREFETCH=10
WORKER_COUNT=10

# Redis (STAGING)
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Indira API
INDIRA_BASE_URL=https://livemiddleware.indiratrade.com

# Paper Trading
PAPER_POSITION_CHECK_INTERVAL_SEC=10

# Odin API
ODIN_BASE_URL=http://localhost:8001
ODIN_API_KEY=dummy
ODIN_X_API_KEY=dummy
ODIN_TIMEOUT=30s
MAX_RETRIES=3
RETRY_DELAY_SEC=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OCO Partial Fill Timeout
OCO_PARTIAL_FILL_TIMEOUT=50

# Market Data WebSocket
PAPER_MARKET_WS_URL=wss://stockkaskwebsocket.indiratrade.com/enhanced-stream

# Environment
DEBUG=true
