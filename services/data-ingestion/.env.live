# Data Ingestion Service Configuration (LIVE)

# Service Configuration
SERVICE_NAME=data-ingestion-service
SERVICE_PORT=50052
ENVIRONMENT=production

# MongoDB (LIVE)
MONGODB_URI=mongodb://admin:admin@mongodb:27017/trading_db?authSource=admin
MONGODB_DATABASE=trading_db

# Kafka (LIVE)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=market.data.news
KAFKA_CONSUMER_GROUP=data-ingestion-group
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=false
