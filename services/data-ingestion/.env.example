# Data Ingestion Service Configuration

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=trading_system
MONGO_NEWS_COLLECTION=news_impact_dashboard

# Kafka Configuration  
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_NEWS=news-events

# 52-week breakout Kafka topic (for Redis-based 52w high strategy)
KAFKA_TOPIC_52W_BREAKOUT=market.data.52w_breakouts

# Service Configuration
LOG_LEVEL=INFO

# External Redis market data (52-week highs, etc.)
# This should point to the Redis instance where keys like
#   market:nse:<token>
#   market:bse:<token>
# are stored with fields including is_new_week_52_high.
MARKET_REDIS_ADDR=............
# MARKET_REDIS_PASSWORD=                # optional, set if Redis is password protected
