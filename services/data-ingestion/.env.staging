# Data Ingestion Service Configuration (STAGING)

# Service Configuration
SERVICE_NAME=data-ingestion-service-staging
SERVICE_PORT=50052
ENVIRONMENT=staging

# MongoDB (STAGING)
MONGODB_URI=mongodb://admin:admin@mongodb-staging:27017/trading_db_staging?authSource=admin
MONGODB_DATABASE=trading_db_staging

# Kafka (STAGING)
KAFKA_BROKERS=kafka-staging:9092
KAFKA_TOPIC=market.data.news
KAFKA_CONSUMER_GROUP=data-ingestion-group-staging
KAFKA_PARTITIONS=50
KAFKA_REPLICATION_FACTOR=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=true
