# User Config Service Configuration (LIVE)

# Service Configuration
SERVICE_NAME=user-config-service
SERVICE_PORT=50051
ENVIRONMENT=production

# PostgreSQL (LIVE)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=trading_db
DATABASE_SSL_MODE=disable
MAX_OPEN_CONNS=25
MAX_IDLE_CONNS=5

# Redis (LIVE)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=false
