# User Config Service Configuration (STAGING)

# Service Configuration
SERVICE_NAME=user-config-service-staging
SERVICE_PORT=50051
ENVIRONMENT=staging

# PostgreSQL (STAGING)
DATABASE_HOST=postgres-staging
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=trading_db_staging
DATABASE_SSL_MODE=disable
MAX_OPEN_CONNS=25
MAX_IDLE_CONNS=5

# Redis (STAGING)
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=true
