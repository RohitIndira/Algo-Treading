# User Config Service Configuration

# Server Configuration
GRPC_PORT=50051

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trading_db
DB_SSLMODE=disable

# Execution DB (execution_db) — where encrypted broker credentials are stored
EXECUTION_DB_HOST=localhost
EXECUTION_DB_PORT=5432
EXECUTION_DB_USER=postgres
EXECUTION_DB_PASSWORD=postgres
EXECUTION_DB_NAME=execution_db
EXECUTION_DB_SSLMODE=disable

# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=user-config-events

# Credential encryption (AES-128/192/256). MUST be exactly 16, 24, or 32 bytes.
# In production set a real, secret key — the service REFUSES TO BOOT with the
# built-in placeholder below unless ALLOW_INSECURE_ENCRYPTION_KEY=true.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# ALLOW_INSECURE_ENCRYPTION_KEY=true  # local dev only — uncomment to permit the
#                                     # placeholder ENCRYPTION_KEY above

# Logging
LOG_LEVEL=INFO
