# Risk Management Service Configuration (STAGING)

# Service Configuration
SERVICE_NAME=risk-management-service-staging
SERVICE_PORT=50055
ENVIRONMENT=staging

# PostgreSQL (STAGING)
DATABASE_HOST=postgres-staging
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=trading_db_staging
DATABASE_SSL_MODE=disable
MAX_OPEN_CONNS=25
MAX_IDLE_CONNS=5

# Redis (STAGING)
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# Risk Limits
MAX_DAILY_LOSS_PERCENT=5.0
MAX_PORTFOLIO_EXPOSURE=80.0
CIRCUIT_BREAKER_THRESHOLD=10.0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
DEBUG=true
