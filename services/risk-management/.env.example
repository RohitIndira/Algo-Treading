# Risk Management Service Configuration

# gRPC port for Risk Management Service
GRPC_PORT=9005

# Redis configuration (real-time risk metrics, positions, counters)
REDIS_HOST=65.20.83.31
REDIS_PORT=6379

# PostgreSQL configuration (if/when you wire historical risk storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=

# Default risk limits (global fallback; per-strategy overrides are passed from callers)
MAX_DAILY_TRADES=100
MAX_DAILY_LOSS=10000
MAX_POSITION_SIZE=50000
MAX_PER_TRADE_RISK=2000
MAX_PORTFOLIO_EXPOSURE_PCT=50
MAX_CONCENTRATION_PCT=30
CIRCUIT_BREAKER_LOSS_PCT=5
