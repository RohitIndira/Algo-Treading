# Risk Management Service Configuration (example)

# gRPC server port
GRPC_PORT=9005

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# (Optional) Postgres configuration if you later add DB usage here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading_system
DB_USER=postgres

# Default risk limits (can be overridden per environment)
MAX_DAILY_TRADES=100
MAX_DAILY_LOSS=10000
MAX_POSITION_SIZE=50000
MAX_PER_TRADE_RISK=2000
MAX_PORTFOLIO_EXPOSURE_PCT=50
MAX_CONCENTRATION_PCT=30
CIRCUIT_BREAKER_LOSS_PCT=5

