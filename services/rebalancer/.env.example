# Rebalancer Service Configuration
#
# Copy to services/rebalancer/.env and fill in real values.
# Every variable main.go reads is listed here — there is no shared fallback.
#
# Run with:
#   go run ./services/rebalancer/cmd/                # all users, real publish
#   go run ./services/rebalancer/cmd/ --dry-run      # plan only, no Kafka
#   go run ./services/rebalancer/cmd/ --user ND03920 # single user
# =============================================================================

# --- PostgreSQL connection ---
# Phase 3 of the DB redesign will flip these to stockk_trading / stockk_market.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable
TRADING_DB=trading_db
MARKET_DB=market_data

# --- Redis (EMA target cache) ---
# REDIS_ADDR wins; REDIS_URI is the legacy var name kept for compatibility.
# DO NOT default to a production IP — leave blank and fail loudly if unset.
REDIS_ADDR=localhost:6379
REDIS_URI=localhost:6379
REDIS_PASSWORD=

# --- Kafka (publishes MANTHAN_ENTRY to trade-signals topic) ---
KAFKA_BROKERS=localhost:9092

# --- Indira broker (live fund-limit, position-book, holdings) ---
# Same URL on dev/staging/prod — Indira has one live endpoint.
INDIRA_BASE_URL=https://livemiddleware.indiratrade.com

# --- user-config gRPC (broker auth + active strategies) ---
USER_CONFIG_GRPC_ADDR=localhost:50051
