# orderstatus svc — environment (deployments/separate-namespace/ecosystem.config.js
# forwards these; its env blocks are whitelists, so a new variable must be added
# there too).

# ── Postgres: order_status_db (broker_events) ───────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable
ORDER_STATUS_DB=order_status_db

# ── Kafka: order.events (events), manthan.notifications (OPS_ALERT) ─────
KAFKA_BROKERS=localhost:9092

# ── HTTP: /health and /metrics (Prometheus) ─────────────────────────────
HTTP_PORT=8090

# ── user-config gRPC: active users + decrypted broker credentials ───────
USER_CONFIG_GRPC_ADDR=localhost:50051

# ── Indira REST base (also derives the WebSocket URLs) ──────────────────
# INDIRA_BASE_URL=https://livemiddleware.indiratrade.com

# ── Dealer broadcast order feed (2026-10-26) ────────────────────────────
# off        not started; service behaves exactly as before this feature
# shadow     connect, parse, compare with the per-user path; write NOTHING (default)
# own_orders write/publish only frames whose UniqueCode/AMOOrderID is in manthan_orders
# all        write/publish every frame of a managed client (manual sells become MANUAL_EXIT)
BROADCAST_FEED_MODE=shadow
# Optional dedicated dealer/ops login whose session anchors the feed. Empty =
# the newest live session among managed users (fallback either way).
BROADCAST_ANCHOR_USER=
# own_orders mode: trade-execution gRPC for LookupOrderMeta. Unset = fail closed.
TRADE_EXEC_GRPC_ADDR=localhost:9004
